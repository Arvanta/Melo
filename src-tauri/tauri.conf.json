{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melo",
  "version": "0.5.0",
  "identifier": "com.melo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Melo",
        "width": 960,
        "height": 240,
        "minWidth": 640,
        "minHeight": 240,
        "maxHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "maxWidth": 960
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../skins/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "aac",
          "ogg",
          "m4a",
          "alac",
          "opus",
          "wma",
          "aiff"
        ],
        "name": "Audio File",
        "description": "Audio File",
        "role": "Viewer",
        "mimeType": "audio/*"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "signCommand": null,
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}