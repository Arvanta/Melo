{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melo",
  "version": "1.0.0",
  "identifier": "com.melo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Melo",
        "width": 960,
        "height": 245,
        "minWidth": 500,
        "minHeight": 230,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http://asset.localhost https://asset.localhost; media-src 'self' asset: blob: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/artwork-cache/**/*"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "aac",
          "ogg",
          "m4a",
          "alac",
          "opus",
          "wma",
          "aiff"
        ],
        "name": "Audio File",
        "description": "Audio File",
        "role": "Viewer",
        "mimeType": "audio/*"
      },
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "M3U Playlist",
        "description": "M3U Playlist (opens in Melo: tracks are queued for playback)",
        "role": "Viewer",
        "mimeType": "audio/x-mpegurl"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "signCommand": null,
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsi"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
